# Mantener hashes de procedencia estables entre Windows, Linux y macOS.
/.gitattributes text eol=lf
*.json text eol=lf
*.geojson text eol=lf
*.xml text eol=lf
*.csv text eol=lf

# Código y documentación portables.
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf

# Artefactos binarios: nunca normalizar su contenido.
*.tif binary
*.tiff binary
*.gpkg binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary
*.nc binary
*.h5 binary
*.hdf5 binary
